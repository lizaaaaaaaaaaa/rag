FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application source
COPY . .

# Expose default port for Streamlit (Cloud Run will set $PORT)
EXPOSE 8080

# Run the Streamlit frontend. Use bash so that $PORT is expanded.
# If PORT is not defined, default to 8080.
CMD ["bash", "-c", "streamlit run app.py --server.port ${PORT:-8080} --server.address 0.0.0.0"]
