# env.recommended (non-secret defaults for all envs)
LOG_LEVEL=INFO
PORT=8080
FAST_MODE=true
ULTRA_FAST_MODE=true
ANTI_HALLUCINATION_MODE=true
RAG_SEARCH_K=2
RAG_CHUNK_SIZE=300
RAG_TIMEOUT=8
LINE_RESPONSE_TIMEOUT=5
ENABLE_RESPONSE_CACHE=true
CACHE_SIZE=50
FAST_RAG_FAQ_FIRST=false
FAST_RAG_TIMEOUT=5.0
FAST_RAG_TOP_K=3
INCLUDE_SOURCES=true
LINE_RAG_STRICT=true
ENABLE_RERANKING=false
ENABLE_VERIFICATION=false
HEALTH_RAG_TEST=false
SESSION_TTL_MINUTES=30
VECTOR_DIR=rag/vectorstore
INDEX_NAME=index
RAG_PROMPT_PATH=rag/prompt_template.txt
STRICT_RAG_ONLY=true
STRICT_GROUNDED_ANSWERING=true
REQUIRE_CITATIONS=false
LOCATION_INTENT_STRICT=true
ENABLE_WEB_SEARCH=false