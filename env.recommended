# Recommended flags for '設定だけで直す' (無改造モード)
TEMPLATE_PRIORITY=false
ENABLE_RAG_AVOIDANCE=false
OPTIMIZED_SEARCH_K=4
OPTIMIZED_RAG_TIMEOUT=8
ENABLE_WEB_SEARCH=false
ENABLE_ANTI_HALLUCINATION=false
RERANK_TOPN=3
USE_LOCAL_LLM=false
LINE_RAG_STRICT=true
LINE_USE_TEMPLATES_ONLY=true
LINE_TEMPLATE_CACHE_TTL=3600
LINE_ALLOW_WEB_SEARCH=false
ENABLE_VERIFICATION=false
GRACEFUL_FALLBACK_LEVELS=template,cache,rag