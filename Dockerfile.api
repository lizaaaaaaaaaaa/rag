FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Environment for production (don't override PORT here)
ENV ENV=production

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code
COPY . .
COPY web ./web

# Expose the default application port (Cloud Run will set $PORT)
EXPOSE 8080

# Run the FastAPI application.  We use bash here so that the
# `$PORT` environment variable provided by Cloud Run is expanded
# correctly at runtime. If `PORT` is not set, default to 8080.
CMD ["bash", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]